{
  "openapi": "3.1.0",
  "info": {
    "title": "security-checklist-tool API",
    "version": "1.0.0",
    "description": "Phase 4 / Wave 1-4 実装 21 ルートのうち REST + SSE 系 18 ルートの OpenAPI 3.1 リファレンス. セッションは sct_session cookie (CC-Auth Cognito ID token)."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "local dev"
    },
    {
      "url": "https://security-checklist-tool-dev.aidreams-factory.com",
      "description": "dev"
    },
    {
      "url": "https://security-checklist-tool.aidreams-factory.com",
      "description": "prod"
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sct_session",
        "description": "CC-Auth (Cognito) ID token を httpOnly cookie で保持"
      }
    },
    "schemas": {
      "Role": {
        "type": "string",
        "enum": [
          "owner",
          "admin",
          "editor",
          "reviewer",
          "viewer"
        ]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "sub": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "orgId": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "sub",
          "email",
          "orgId",
          "role",
          "permissions"
        ]
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "urn:problem:sct:invalid_input"
          },
          "title": {
            "type": "string",
            "example": "Invalid input"
          },
          "status": {
            "type": "integer",
            "example": 400
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "errors": {}
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "description": "RFC 7807 Problem Details for HTTP APIs"
      },
      "ReviewerAssignments": {
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "assessmentId": {
                  "type": "string"
                },
                "assessmentTitle": {
                  "type": "string"
                },
                "controlTitle": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "guidelineName": {
                  "type": "string"
                },
                "guidelineVersion": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "id",
                "assessmentId",
                "assessmentTitle",
                "controlTitle",
                "category",
                "guidelineName",
                "guidelineVersion",
                "updatedAt"
              ]
            }
          }
        },
        "required": [
          "role",
          "items"
        ]
      },
      "CompanyAccepted": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "analyzing",
              "completed"
            ]
          },
          "pollUrl": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "domain",
          "status",
          "pollUrl"
        ]
      },
      "Company": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "industry": {
            "type": [
              "string",
              "null"
            ]
          },
          "size": {
            "type": [
              "string",
              "null"
            ]
          },
          "inferredData": {},
          "inferenceConfidence": {
            "type": [
              "integer",
              "null"
            ]
          },
          "userOverrides": {},
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "domain",
          "displayName",
          "industry",
          "size",
          "inferenceConfidence",
          "createdAt"
        ]
      },
      "Industry": {
        "type": "string",
        "enum": [
          "medical-saas",
          "manufacturing",
          "finance",
          "retail",
          "public-sector",
          "automotive",
          "logistics",
          "education",
          "real-estate",
          "media",
          "it-services",
          "professional-services",
          "energy",
          "agriculture",
          "unknown"
        ]
      },
      "GuidelineSuggestions": {
        "type": "object",
        "properties": {
          "inferredIndustry": {
            "$ref": "#/components/schemas/Industry"
          },
          "rerank": {
            "type": "object",
            "properties": {
              "applied": {
                "type": "boolean"
              },
              "degraded": {
                "type": "boolean"
              },
              "provider": {
                "type": "string"
              }
            },
            "required": [
              "applied",
              "degraded",
              "provider"
            ]
          },
          "baseline": {
            "type": "array",
            "items": {}
          },
          "industryMatch": {
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "inferredIndustry",
          "rerank",
          "baseline",
          "industryMatch"
        ]
      },
      "AssessmentCreateResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "in_progress"
            ]
          },
          "itemCount": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "status",
          "itemCount"
        ]
      },
      "AssessmentCreateRequest": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "selectedGuidelineIds": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            },
            "maxItems": 100
          },
          "applyBaseline": {
            "type": "boolean",
            "default": true
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "required": [
          "companyId",
          "selectedGuidelineIds",
          "title"
        ]
      },
      "AssessmentItemStatus": {
        "type": "string",
        "enum": [
          "open",
          "in_progress",
          "done",
          "not_applicable"
        ]
      },
      "AssessmentItemPatch": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/AssessmentItemStatus"
          },
          "note": {
            "type": "string",
            "maxLength": 8000
          },
          "assigneeId": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d+$"
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "evidenceUrl": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048,
            "format": "uri"
          }
        }
      },
      "RatingRequest": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "string",
            "enum": [
              "good",
              "bad"
            ]
          }
        },
        "required": [
          "rating"
        ]
      },
      "ExportRequest": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "xlsx",
              "pdf",
              "csv"
            ]
          }
        },
        "required": [
          "format"
        ]
      },
      "Dashboard": {
        "type": "object",
        "properties": {
          "assessmentId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "totalCount": {
            "type": "integer"
          },
          "statusCounts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "completionRate": {
            "type": "number"
          },
          "overdueCount": {
            "type": "integer"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string"
                },
                "total": {
                  "type": "integer"
                },
                "done": {
                  "type": "integer"
                },
                "byStatus": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer"
                  }
                }
              },
              "required": [
                "category",
                "total",
                "done",
                "byStatus"
              ]
            }
          }
        },
        "required": [
          "assessmentId",
          "title",
          "status",
          "totalCount",
          "statusCounts",
          "completionRate",
          "overdueCount",
          "categories"
        ]
      },
      "InviteResponse": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "token": {
            "type": "string"
          },
          "inviteUrl": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "email",
          "role",
          "token",
          "inviteUrl",
          "expiresAt"
        ]
      },
      "InviteRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 320,
            "format": "email"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "message": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "email",
          "role"
        ]
      },
      "RoleUpdateRequest": {
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "GuidelineImportResponse": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "json",
              "csv"
            ]
          },
          "total": {
            "type": "integer"
          },
          "created": {
            "type": "integer"
          },
          "updated": {
            "type": "integer"
          }
        },
        "required": [
          "format",
          "total",
          "created",
          "updated"
        ]
      },
      "GuidelineImportItem": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "issuer": {
            "type": "string",
            "maxLength": 128
          },
          "category": {
            "type": "string",
            "maxLength": 32
          },
          "domainTags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "isBaseline": {
            "type": "boolean",
            "default": false
          },
          "sourceUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        },
        "required": [
          "code",
          "name",
          "issuer",
          "category"
        ]
      },
      "AuditLogRow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ts": {
            "type": "string",
            "format": "date-time"
          },
          "action": {
            "type": "string"
          },
          "resourceType": {
            "type": "string"
          },
          "resourceId": {
            "type": [
              "string",
              "null"
            ]
          },
          "beforeValue": {},
          "afterValue": {},
          "ipAddress": {
            "type": [
              "string",
              "null"
            ]
          },
          "user": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "role": {
                "$ref": "#/components/schemas/Role"
              }
            },
            "required": [
              "id",
              "email",
              "role"
            ]
          }
        },
        "required": [
          "id",
          "ts",
          "action",
          "resourceType",
          "resourceId",
          "ipAddress",
          "user"
        ]
      },
      "AuditLogPage": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditLogRow"
            }
          }
        },
        "required": [
          "page",
          "pageSize",
          "total",
          "rows"
        ]
      },
      "LatestVersion": {
        "type": "object",
        "properties": {
          "latestReleasedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "latestVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "activeGuidelineVersions": {
            "type": "integer"
          }
        },
        "required": [
          "latestReleasedAt",
          "latestVersion",
          "activeGuidelineVersions"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/me": {
      "get": {
        "description": "現在のセッションユーザーと許可操作一覧を返す",
        "tags": [
          "session"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/reviewer-assignments": {
      "get": {
        "description": "Reviewer (および上位ロール) の確認待ち項目一覧",
        "tags": [
          "session"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewerAssignments"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies": {
      "post": {
        "description": "URL投入 → SSRF safe crawl → LLM 推定 → upsert (editor 以上)",
        "tags": [
          "companies"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "url"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted (推定完了)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyAccepted"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "422": {
            "description": "URL Blocked (SSRF / 不正 URL)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies/stream": {
      "post": {
        "description": "同上を SSE でステージ毎にイベント配信 (validating/crawling/estimating/persisting/done)",
        "tags": [
          "companies",
          "sse"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "text/event-stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies/{id}": {
      "get": {
        "description": "Company プロフィール取得 (推定根拠含む)",
        "tags": [
          "companies"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Company"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/companies/{id}/guideline-suggestions": {
      "get": {
        "description": "baseline + industry-match candidates + LLM rerank",
        "tags": [
          "companies",
          "guidelines"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuidelineSuggestions"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
