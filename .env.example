# =====================================================================
# security-checklist-tool — Environment variables (template)
# Copy to `.env.local` for local development. NEVER commit `.env.local`.
# Phase 4 / Wave 1 — values must be supplied via SSM or local secrets.
# =====================================================================

# ---- App ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Security Checklist Tool"
NEXT_PUBLIC_APP_ENV=local           # local | dev | prod

# ---- CC-Auth (Cognito + PKCE) ---------------------------------------
# .ccagi.yml `cc_auth.localhost_*` と一致させること。
NEXT_PUBLIC_CC_AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_CC_AUTH_POST_LOGIN_REDIRECT=http://localhost:3000

# Cognito 構成 (本番は SSM Parameter Store から動的取得 — ここはローカル用フォールバック)
# /security-checklist-tool/{env}/cognito/user_pool_id
COGNITO_USER_POOL_ID=
# /security-checklist-tool/{env}/cognito/client_id
COGNITO_CLIENT_ID=
# /security-checklist-tool/{env}/cognito/region
COGNITO_REGION=ap-northeast-1
# Cognito Hosted UI Domain (例: security-checklist-tool-dev.auth.ap-northeast-1.amazoncognito.com)
COGNITO_DOMAIN=

# Session (JWT 検証 / 署名)
SESSION_SECRET=
SESSION_COOKIE_NAME=sct_session

# ---- Database (PostgreSQL) ------------------------------------------
DATABASE_URL=postgresql://sct:sct_pw@localhost:5432/security_checklist_tool?schema=public

# ---- LLM (Anthropic / OpenAI) — Wave 2 で利用 ----------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic               # anthropic | openai
LLM_MODEL=claude-3-5-sonnet-latest

# ---- Object storage (S3) — Wave 3 でエクスポートに使用 -------------
S3_BUCKET=
S3_REGION=ap-northeast-1
S3_PRESIGN_TTL_SEC=600

# ---- Observability (任意) -------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_LOG_LEVEL=info
